# Exchange API Credentials (for market data, balances, positions)
DELTA_API_KEY=your_delta_api_key
DELTA_API_SECRET=your_delta_api_secret
PI42_API_KEY=your_pi42_api_key
PI42_API_SECRET=your_pi42_api_secret

# Trading API Credentials (separate keys for order placement - Phase 3)
DELTA_API_KEY_trade=your_delta_trading_api_key
DELTA_API_SECRET_trade=your_delta_trading_api_secret
PI42_API_KEY_trade=your_pi42_trading_api_key
PI42_API_SECRET_trade=your_pi42_trading_api_secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/funding-arbitrage
MONGODB_DB_NAME=funding-arbitrage

# Trading Configuration
LEVERAGE=10
USE_FUND_PCT=0.70
PRIMARY_THRESHOLD=0.1
SECONDARY_THRESHOLD=0.1
FUNDING_TIME_WINDOW_SECONDS=60
MIN_FILL_PCT=0.95
ENTRY_TIMEOUT_SECONDS=30
POLL_INTERVAL_SECONDS=5
MAX_WAIT_FOR_FUNDING_SECONDS=300

# Phase 2: Position Sizing
MAX_POSITION_SIZE_USD=1000
MIN_POSITION_SIZE_USD=10

# Phase 2: Liquidity & Slippage
MIN_LIQUIDITY_MULTIPLIER=3.0
MAX_SLIPPAGE_PCT=0.1
ORDERBOOK_DEPTH=20

# Phase 2: Profit Requirements
MIN_NET_PROFIT_PCT=0.05

# Phase 3: Order Execution Cooldown
# Wait time (in minutes) between successful order executions
ORDER_COOLDOWN_MINUTES=15

# Phase 2 & 3: Testing
PAPER_TRADING_MODE=false

# Environment
NODE_ENV=development
